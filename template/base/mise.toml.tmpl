[tools]
pre-commit = "4.7.0"

[env]
_.file = ".env"

[tasks.check]
description = "Run every check on the project"
run = [
  "pre-commit run --all-files",
[[- if ne .backend "none" ]]
  "mise --cd backend run lint",
  "mise --cd backend run test",
[[- end ]]
[[- if ne .frontend "none" ]]
  "mise --cd frontend run lint",
  "mise --cd frontend run test",
[[- end ]]
]
[[- if or (eq .backend "ts") (eq .frontend "react") ]]

[tasks.check-vite-plus-pins]
description = "Check that the Vite+ pins in pnpm-workspace.yaml match the installed Vite+"
run = "node scripts/check-vite-plus-pins.ts"

[tasks.upgrade-vite-plus]
description = "Re-pin the vite alias and Vitest to the installed vite-plus"
run = "pnpm exec vp migrate --no-interactive"
[[- end ]]
